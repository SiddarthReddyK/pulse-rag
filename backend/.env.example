# ─────────────────────────────────────────────────────────────────
# Pulse RAG — backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# --- LLM provider (Groq) ---
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- App settings ---
# development | production
APP_ENV=development
MAX_FILE_SIZE_MB=10
# Comma-separated list of origins allowed to call the API (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Models (optional overrides; defaults shown) ---
# LLM_MODEL=qwen/qwen3.8-27b
# VISION_MODEL=qwen/qwen3.8-27b

# --- RAG / embeddings ---
# fastembed = real semantic embeddings (downloads a small model on first run)
# hashing   = lightweight offline fallback, used by the test suite
EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_TOP_K=5
# RAG_MAX_CHUNKS=8